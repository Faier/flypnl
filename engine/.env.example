# Copy to .env for LIVE mode. Keys need SPOT TRADE permission ONLY.
# Never enable withdrawal permission. Start with a dedicated sub-account.
FLYGATE_KEY=your_gate_api_key
FLYGATE_SECRET=your_gate_api_secret

# State directory override (optional). Every state file — engine.lock,
# {pair}.broker.json, {pair}.brain.npz, risk.json, KILL — is keyed by filename
# only, so a second deployment MUST use its own directory. The 50 USDT real
# satellite account therefore runs beside the paper main show as:
#
#   FLYGATE_RUNS=~/flygate-satellite/runs \
#     python3 -m flygate --config config.satellite.json live --preflight-only
#   FLYGATE_RUNS=~/flygate-satellite/runs \
#     python3 -m flygate --config config.satellite.json live
#
# Leave unset for the default <repo>/runs (paper main show).
# FLYGATE_RUNS=~/flygate-satellite/runs
