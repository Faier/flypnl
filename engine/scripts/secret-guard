#!/bin/bash
# flypnl secret guard — 拦截密钥/隐私文件进入 git(pre-commit 与 pre-push 通用)。
#
#   安装(每台机器一次):
#     install -m 755 engine/scripts/secret-guard .git/hooks/pre-commit
#     install -m 755 engine/scripts/secret-guard .git/hooks/pre-push
#
# 三层防线:
#   1) 敏感路径:.env / state/ / runs/ 状态与流水 / 数据缓存 / token 文件
#   2) 密钥模式:FLYGATE_KEY/SECRET 赋值、ghp_/sk-/AKIA、长 hex/base64 串
#   3) 真实值反查:拿本地 engine/.env 里的真实密钥前 12 位指纹比对 diff——
#      模式漏掉的变体也逃不过这一层(只报命中,永不回显密钥本身)
rc=0
say() { echo >&2 "[secret-guard] $*"; }

# 待检范围:pre-commit 用暂存区,pre-push 用 stdin 的提交区间
RANGE=()
if [ "$1" = "--staged" ]; then
    DIFF_FLAGS=(--cached)
    RANGE=("")          # 空区间 = 全部暂存 diff
else
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ "${#local_sha}" -ne 40 ] && continue
        if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            RANGE+=("$local_sha --not --remotes")
        else
            RANGE+=("$remote_sha..$local_sha")
        fi
    done
    [ ${#RANGE[@]} -eq 0 ] && exit 0
    DIFF_FLAGS=()
fi

for range in "${RANGE[@]}"; do
    # ---- 1) 敏感路径 ----
    bad=$(git diff --name-only ${DIFF_FLAGS[@]} $range 2>/dev/null | grep -E \
        -e '(^|/)\.env$' -e '^state/' \
        -e 'engine/runs/.*\.(json|jsonl|npz|token)$' \
        -e 'engine/data/cache/' \
        -e '\.broker\.json$' -e 'dashboard\.token$')
    if [ -n "$bad" ]; then
        say "⛔ 敏感文件试图入库:"; echo >&2 "$bad" | sed 's/^/    /'
        say "   .env/state/runs 属于私有数据,永不提交。先加 .gitignore 再说。"
        rc=1
    fi

    # ---- 2) 密钥模式(排除占位符/测试假数据) ----
    hits=$(git diff ${DIFF_FLAGS[@]} $range 2>/dev/null | grep -E \
        -e 'FLYGATE_(KEY|SECRET)[[:space:]]*=[[:space:]]*[A-Za-z0-9]{12,}' \
        -e '(api[_-]?key|secret|passwd)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_\-]{20,}' \
        -e 'ghp_[A-Za-z0-9]{20,}' -e 'sk-[A-Za-z0-9]{20,}' -e 'AKIA[A-Z0-9]{16}' \
        | grep -v -E 'your_|example|placeholder|not-secret|unit-test|dummy|xxxx')
    if [ -n "$hits" ]; then
        say "⛔ diff 里出现疑似真实密钥(已隐藏内容,共 $(echo "$hits" | wc -l | tr -d ' ') 处):"
        echo >&2 "$hits" | cut -c1-60 | sed 's/^/    /'
        rc=1
    fi

    # ---- 3) 真实值指纹反查 ----
    if [ -f engine/.env ]; then
        while IFS='=' read -r k v; do
            case "$k" in ''|\#*) continue ;; esac
            v="${v%%[[:space:]]*}"
            fp="${v:0:12}"
            [ ${#fp} -lt 12 ] && continue
            if git diff ${DIFF_FLAGS[@]} $range 2>/dev/null | grep -F -q -- "$fp"; then
                say "⛔ diff 中发现与 engine/.env 里 $k 相同的真实密钥指纹!"
                rc=1
            fi
        done < engine/.env
    fi
done

[ $rc -eq 0 ] && say "✅ 密钥守卫通过"
exit $rc
